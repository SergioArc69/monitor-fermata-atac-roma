<Window x:Class="MonitorFermataAtacRoma.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Icon="Assets/bus.ico"
        Title="Informazioni" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20" HorizontalAlignment="Center">
        <Image Source="Assets/bus.ico" Width="48" Height="48" Margin="0,0,0,10"/>

        <TextBlock Text="Monitor Fermata ATAC Roma" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionTextBlock" HorizontalAlignment="Center" Foreground="Gray" Margin="0,2,0,14"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4">
            <Run Text="di "/>
            <Run Text="Sergio Arcangeli" FontWeight="SemiBold"/>
        </TextBlock>

        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4">
            <Hyperlink x:Name="RepositoryLink" Click="RepositoryLink_Click">
                Repository su GitHub
            </Hyperlink>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,14">
            <Hyperlink x:Name="ReleasesLink" Click="ReleasesLink_Click">
                Ultime versioni (Releases)
            </Hyperlink>
        </TextBlock>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,4">
            Dati orari e posizioni bus da Roma Mobilità (GTFS / GTFS-RT open data).
        </TextBlock>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,4">
            Mappe © collaboratori di OpenStreetMap.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,16">
            Software rilasciato nel pubblico dominio (Unlicense).
        </TextBlock>

        <Button Content="Chiudi" Padding="16,6" HorizontalAlignment="Center" Click="CloseButton_Click"/>
    </StackPanel>
</Window>
