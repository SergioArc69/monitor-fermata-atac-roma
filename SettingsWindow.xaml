<Window x:Class="MonitorFermataAtacRoma.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Icon="Assets/bus.ico"
        Title="Impostazioni" Height="250" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <CheckBox x:Name="AutoStartCheckBox" Content="Avvia con Windows" Margin="0,0,0,16"
                  Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>

        <Button x:Name="RefreshDataButton" Content="Aggiorna dati linee e fermate"
                HorizontalAlignment="Left" Padding="10,6" Click="RefreshDataButton_Click"/>
        <TextBlock x:Name="StatusTextBlock" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>

        <Grid Margin="0,24,0,0">
            <Button x:Name="AboutButton" Content="Informazioni" HorizontalAlignment="Left"
                    Padding="16,6" Click="AboutButton_Click"/>
            <Button x:Name="CloseButton" Content="Chiudi" HorizontalAlignment="Right"
                    Padding="16,6" Click="CloseButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
