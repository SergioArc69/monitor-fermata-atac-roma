<Window x:Class="MonitorFermataAtacRoma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitorFermataAtacRoma"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Icon="Assets/bus.ico"
        Title="Monitor Fermata ATAC Roma" Height="520" Width="840"
        Closing="Window_Closing" StateChanged="Window_StateChanged" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="MapButton" Content="🗺" FontSize="14" Padding="8,4" Margin="0,0,8,0"
                    ToolTip="Mostra mappa" Click="MapButton_Click"/>
            <TextBlock Text="Fermata:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="StopIdComboBox" Width="280" IsEditable="True" IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True" VerticalContentAlignment="Center"
                      KeyDown="StopIdComboBox_KeyDown" GotFocus="StopIdComboBox_GotFocus"
                      SelectionChanged="StopIdComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} — {1}">
                                    <Binding Path="StopId"/>
                                    <Binding Path="StopName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="StopNameHintTextBlock" VerticalAlignment="Center" Margin="8,0,0,0"
                       Width="220" FontStyle="Italic" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="StartButton" Content="Monitora" Margin="8,0,0,0" Padding="12,4" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Ferma" Margin="8,0,0,0" Padding="12,4" Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="ExitButton" Content="Esci" Margin="8,0,0,0" Padding="12,4" Click="ExitButton_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="SettingsButton" Content="Impostazioni" Padding="10,4" VerticalAlignment="Center"
                    Click="SettingsButton_Click"/>
            <CheckBox x:Name="NotifyCheckBox" Content="Notifica quando mancano meno di"
                      VerticalAlignment="Center" Margin="20,0,4,0" IsChecked="True"/>
            <wfi:WindowsFormsHost x:Name="NotifyMinutesHost" Width="50" Height="22" VerticalAlignment="Center"/>
            <TextBlock Text="minuti" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock Text="tra le" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <wfi:WindowsFormsHost x:Name="NotifyFromHost" Width="66" Height="22" VerticalAlignment="Center"/>
            <TextBlock Text="e le" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <wfi:WindowsFormsHost x:Name="NotifyToHost" Width="66" Height="22" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <CheckBox x:Name="LineFilterCheckBox" Content="Filtra per linea" Margin="0,0,0,4"
                          Checked="LineFilterCheckBox_Changed" Unchecked="LineFilterCheckBox_Changed"/>
                <ListBox x:Name="LineFilterListBox" SelectionMode="Extended"
                         SelectionChanged="LineFilterListBox_SelectionChanged"/>
            </StackPanel>

            <DataGrid x:Name="ArrivalsGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Destinazione" Binding="{Binding DestinationLabel}" Width="*"/>
                    <DataGridTextColumn Header="Arrivo previsto" Binding="{Binding ArrivalTime, StringFormat='HH:mm:ss'}" Width="120"/>
                    <DataGridTextColumn Header="Tra" Binding="{Binding MinutesLabel}" Width="90"/>
                    <DataGridTextColumn Header="Stato" Binding="{Binding DelayLabel}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, StringFormat='Linea {0}'}" FontWeight="Bold"
                                           Background="#FFEDEDED" Padding="6,3" Margin="0,4,0,0"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
            </DataGrid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,10,0,0" Foreground="Gray"
                   Text="Inserisci un codice fermata e premi Monitora."/>
    </Grid>
</Window>
